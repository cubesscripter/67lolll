-- Viewmodel Chams
local function updateViewmodelChams()
    if not ESPConfig.viewmodelchams then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    for _, child in ipairs(camera:GetChildren()) do
        if child:IsA("Model") or child:IsA("Tool") then
            for _, part in ipairs(child:GetDescendants()) do
                if part:IsA("BasePart") and not part:FindFirstChild("ViewmodelCham") then
                    local cham = Instance.new("Highlight")
                    cham.Name = "ViewmodelCham"
                    cham.FillColor = ESPConfig.viewmodelcolor
                    cham.OutlineColor = Color3.new(0, 0, 0)
                    cham.FillTransparency = 0.3
                    cham.Parent = part
                end
            end
        end
    end
end

-- Click TP
local function onInputBegan(input, gameProcessed)
    if gameProcessed then return end
    if PlayerConfig.clicktp and input.UserInputType == Enum.UserInputType.MouseButton1 and UserInputService:IsKeyDown(PlayerConfig.clicktpkey) then
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local mousePos = Mouse.Hit
        if mousePos then
            hrp.CFrame = CFrame.new(mousePos.Position + Vector3.new(0, 3, 0))
        end
    end
end
UserInputService.InputBegan:Connect(onInputBegan)

