local function getDistanceBasedHitChance(targetPart, originPos)
    local baseChance = math.clamp(tonumber(SAConfig.hitchance) or 0, 0, 100)
    if not SAConfig.distancebasedhitchance or not targetPart then return baseChance end
    local origin = originPos or getFireOriginPosition()
    if not origin then local originPart = getLocalAimOriginPart() origin = originPart and originPart.Position end
    if not origin then return baseChance end
    local distance, selectedChance = (targetPart.Position - origin).Magnitude, baseChance
    local points = {
        {d = math.max(tonumber(SAConfig.distancehitchance1dist) or 0, 0), c = math.clamp(tonumber(SAConfig.distancehitchance1value) or baseChance, 0, 100)},
        {d = math.max(tonumber(SAConfig.distancehitchance2dist) or 0, 0), c = math.clamp(tonumber(SAConfig.distancehitchance2value) or baseChance, 0, 100)},
        {d = math.max(tonumber(SAConfig.distancehitchance3dist) or 0, 0), c = math.clamp(tonumber(SAConfig.distancehitchance3value) or baseChance, 0, 100)},
        {d = math.max(tonumber(SAConfig.distancehitchance4dist) or 0, 0), c = math.clamp(tonumber(SAConfig.distancehitchance4value) or baseChance, 0, 100)},
        {d = math.max(tonumber(SAConfig.distancehitchance5dist) or 0, 0), c = math.clamp(tonumber(SAConfig.distancehitchance5value) or baseChance, 0, 100)}
    }
    table.sort(points, function(a, b) return a.d < b.d end)
    for _, p in ipairs(points) do if p.d > 0 and distance >= p.d then selectedChance = p.c end end
    return selectedChance
end

local function getMissPos(startPos, targetPartOrPos)
    local targetPart = typeof(targetPartOrPos) == "Instance" and targetPartOrPos:IsA("BasePart") and targetPartOrPos or nil
    local targetPos = targetPart and targetPart.Position or targetPartOrPos
    if not targetPos then return startPos end
    local toTarget = targetPos - startPos
    if toTarget.Magnitude <= 0.001 then return targetPos + Vector3.new(SAConfig.missspread + 6, 0, 0) end
    local direction = toTarget.Unit
    local reference = math.abs(direction.Y) > 0.98 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
    local right = direction:Cross(reference)
    if right.Magnitude <= 0.001 then right = Vector3.new(0, 0, 1) else right = right.Unit end
    local up = right:Cross(direction)
    if up.Magnitude <= 0.001 then up = Vector3.new(0, 1, 0) else up = up.Unit end
    local partRadius = targetPart and math.max(targetPart.Size.X, targetPart.Size.Y, targetPart.Size.Z) * 0.75 or 2
    local missRadius = math.max(SAConfig.missspread, partRadius + 3)
    local angle = rng:NextNumber(0, math.pi * 2)
    return targetPos + (right * math.cos(angle) * missRadius + up * math.sin(angle) * missRadius)
end

