local function updateSkeleton()
    if not ESPConfig.skeleton then
        for _, line in pairs(skeletonLines) do line.Visible = false end
        return
    end
    local index = 1
    for _, player in ipairs(Players:GetPlayers()) do
        if shouldShowEsp(player) and player.Character then
            local char = player.Character
            for _, connection in ipairs(skeletonConnections) do
                local part1 = char:FindFirstChild(connection[1])
                local part2 = char:FindFirstChild(connection[2])
                if part1 and part2 then
                    local pos1, onScreen1 = Camera:WorldToViewportPoint(part1.Position)
