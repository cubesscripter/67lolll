local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.IgnoreWater = true
wallParams.RespectCanCollide = false

local function wallBetween(startPos, endPos, targetChar)
    local myChar = LocalPlayer.Character
    if not myChar then return true end
    local filter = {myChar}
    if targetChar then table.insert(filter, targetChar) end
    wallParams.FilterDescendantsInstances = filter
    local direction = endPos - startPos
    local distance = direction.Magnitude
    if distance <= 0.001 then return false end
    local unit = direction.Unit
    local currentStart, remaining = startPos, distance
    for _ = 1, 10 do
        local result = workspace:Raycast(currentStart, unit * remaining, wallParams)
        if not result then return false end
        if result.Instance.Transparency < 0.8 and result.Instance.CanCollide then return true end
        local hitDist = (result.Position - currentStart).Magnitude
        remaining = remaining - hitDist - 0.01
        if remaining <= 0 then return false end
        currentStart = result.Position + unit * 0.01
    end
    return false
end

local function quickCheck(player)
    if not player or player == LocalPlayer or not player.Character then return false end
    local targetPart = getTargetPart(player.Character)
    if not targetPart then return false end
    if not isWithinAimDistance(targetPart.Position) then return false end
    if not isInCurrentGunRange(targetPart.Position) then return false end
    if SAConfig.deathcheck and isDead(player) then return false end
    if SAConfig.ffcheck and hasForceField(player) then return false end
    if SAConfig.vehiclecheck and isInVehicle(player) then return false end
    if SAConfig.teamcheck and player.Team == LocalPlayer.Team then return false end
    if SAConfig.criminalsnoinnmates and LocalPlayer.Team == criminalsTeam and player.Team == inmatesTeam then return false end
    if SAConfig.inmatesnocriminals and LocalPlayer.Team == inmatesTeam and player.Team == criminalsTeam then return false end
    if SAConfig.hostilecheck or SAConfig.trespasscheck then
        local isTaser, bypassHostile, bypassTrespass = isTaserGun(currentGun), SAConfig.taserbypasshostile and isTaserGun(currentGun), SAConfig.taserbypasstrespass and isTaserGun(currentGun)
        local targetChar = player.Character
        if LocalPlayer.Team == guardsTeam and player.Team == inmatesTeam then
            local hostile, trespass = targetChar:GetAttribute("Hostile"), targetChar:GetAttribute("Trespassing")
            if SAConfig.hostilecheck and SAConfig.trespasscheck then
                if not bypassHostile and not bypassTrespass and not hostile and not trespass then return false end
            elseif SAConfig.hostilecheck and not bypassHostile and not hostile then return false
            elseif SAConfig.trespasscheck and not bypassTrespass and not trespass then return false end
        end
    end
    return true
end

local function fullCheck(player)
    if not quickCheck(player) then return false end
    if SAConfig.wallcheck then
        local myChar, myHead = LocalPlayer.Character, nil
        if myChar then myHead = myChar:FindFirstChild("Head") end
        local targetPart = getTargetPart(player.Character)
        if myHead and targetPart and wallBetween(myHead.Position, targetPart.Position, player.Character) then return false end
    end
    return true
end

