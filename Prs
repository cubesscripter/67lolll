-- Update ESP
local function updateEsp()
    if not ESPConfig.enabled then
        for _, e in pairs(espCache) do e.Parent = nil end
        for _, player in ipairs(Players:GetPlayers()) do removeChams(player.Character) end
        return
    end
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for _, player in ipairs(Players:GetPlayers()) do
        local show = shouldShowEsp(player)
        if show then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            if hrp and head then
                local esp = makeEsp(player)
                esp.Adornee = head
                esp.Parent = CoreGui
                local d = esp:FindFirstChild("Diamond")
                if d then d.BackgroundColor3 = getTeamColor(player) end
                local distLabel = esp:FindFirstChild("DistanceLabel")
                if distLabel then
                    if ESPConfig.showdistance and myHrp then
                        distLabel.Text = math.floor((hrp.Position - myHrp.Position).Magnitude) .. "m"
                        distLabel.Visible = true
                    else distLabel.Visible = false end
                end
                local nameLabel = esp:FindFirstChild("NameLabel")
                if nameLabel then nameLabel.Visible = ESPConfig.shownames end
                if ESPConfig.chams then applyChams(char, getTeamColor(player)) end
            end
        else
            local e = espCache[player]
            if e then e.Parent = nil end
            removeChams(player.Character)
        end
    end
end

