-- Auto Arrest Aura - FIXED
local arrestingPlayers = {}
local lastArrestTime = 0

local function autoArrest()
    if not AutoConfig.autoarrest then return end
    local now = tick()
    if now - lastArrestTime < 0.5 then return end
    
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    
    -- Only works for guards
    if LocalPlayer.Team ~= guardsTeam then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team == criminalsTeam and not arrestingPlayers[player] then
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if hrp and humanoid and humanoid.Health > 0 then
                    local dist = (hrp.Position - myHrp.Position).Magnitude
                    if dist <= AutoConfig.autoarrestdistance then
                        arrestingPlayers[player] = true
                        lastArrestTime = now
                        
                        -- Try multiple arrest methods
                        task.spawn(function()
                            -- Method 1: Direct remote
                            if ArrestEvent then
                                pcall(function()
                                    ArrestEvent:InvokeServer(player)
                                end)
                            end
                            
                            -- Method 2: Proximity based
                            pcall(function()
                                local arrestPart = char:FindFirstChild("ArrestPart") or hrp
                                if arrestPart then
                                    -- Fire touch interest
                                    firetouchinterest(myHrp, arrestPart, 0)
                                    firetouchinterest(myHrp, arrestPart, 1)
                                end
                            end)
                            
                            task.wait(2)
                            arrestingPlayers[player] = nil
                        end)
                    end
                end
            end
        end
    end
end

-- Auto Escape - FIXED
local function autoEscape()
    if not AutoConfig.autoescape then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    -- Check if arrested or handcuffed
    local isRestrained = false
    
    if char:FindFirstChild("Handcuffs") then
        isRestrained = true
        char.Handcuffs:Destroy()
    end
    
    if char:GetAttribute("Arrested") then
        isRestrained = true
        char:SetAttribute("Arrested", nil)
    end
    
    -- Check for arrest GUI
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local arrestGui = playerGui:FindFirstChild("ArrestedGui") or playerGui:FindFirstChild("Cuffed")
        if arrestGui then
            isRestrained = true
            arrestGui:Destroy()
        end
    end
    
    -- Break joints/constraints
    if isRestrained then
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BallAndSocketConstraint") or obj:IsA("HingeConstraint") or obj:IsA("Weld") then
                if obj.Name:lower():find("hand") or obj.Name:lower():find("cuff") or obj.Name:lower():find("arrest") then
                    obj:Destroy()
                end
            end
        end
        
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end

-- Auto Enter Vehicle - FIXED
local function autoEnterVehicle()
    if not AutoConfig.autoentervehicle then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.SeatPart then return end
    
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    
    -- Search for vehicles
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") and not obj.Occupant then
            local dist = (obj.Position - myHrp.Position).Magnitude
            if dist <= 15 then
                -- Move towards seat and sit
                local direction = (obj.Position - myHrp.Position).Unit
                myHrp.CFrame = myHrp.CFrame + direction * math.min(dist, 5)
                
                if dist <= 5 then
                    humanoid:Sit(obj)
                    return
                end
            end
        end
    end
end

-- Auto Interact/Auto Open Door - FIXED
local function autoInteract()
    if not AutoConfig.autointeract and not AutoConfig.autoopendoor then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local myHrp = char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    
    -- Look for doors and buttons
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            
            -- Check if it's a door or button
            if name:find("door") or name:find("button") or name:find("keypad") then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local dist = (part.Position - myHrp.Position).Magnitude
                    if dist <= 8 then
                        -- Fire touch interest
                        firetouchinterest(myHrp, part, 0)
                        firetouchinterest(myHrp, part, 1)
                        
                        -- Try click detector
                        local clickDetector = obj:FindFirstChildOfClass("ClickDetector")
                        if clickDetector then
                            fireclickdetector(clickDetector)
                        end
                        
                        -- Try proximity prompt
                        local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                        if prompt then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end
        end
    end
end

-- Auto Grab - FIXED
local function updateAutoGrab()
    if not AutoConfig.autograb or not GiverPressed then return end
    
    local now = tick()
    if now - lastAutoGrab < 0.1 then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if not root then return end
    
    local grabDistance = math.clamp(tonumber(AutoConfig.autograbdistance) or 0, 0, 12)
    if grabDistance <= 0 then return end
    
    local grabDistanceSq = grabDistance * grabDistance
    
    for item in pairs(trackedGrabbables) do
        if not item or not item.Parent then
            trackedGrabbables[item] = nil
            firstSeenGrabbables[item] = nil
        elseif not shouldAutoGrabItem(item) then
            firstSeenGrabbables[item] = nil
        elseif isOwnedGrabbable(item) then
            firstSeenGrabbables[item] = nil
        else
            local part = getGrabbablePart(item)
            if part and distSq(root.Position, part.Position) <= grabDistanceSq then
                if not firstSeenGrabbables[item] then
                    firstSeenGrabbables[item] = now
                elseif now - firstSeenGrabbables[item] >= AutoConfig.autograbdelay then
                    lastAutoGrab = now
                    firstSeenGrabbables[item] = nil
                    
                    -- Try to grab item
                    pcall(function()
                        GiverPressed:FireServer(item)
                    end)
                    
                    -- Alternative method: touch interest
                    pcall(function()
                        firetouchinterest(root, part, 0)
                        firetouchinterest(root, part, 1)
                    end)
                    
                    notify("Auto Grab", "Picked up " .. item.Name, 1)
                end
            else
                firstSeenGrabbables[item] = nil
            end
        end
    end
end

-- Main Automation Loop
local function runAutomation()
    updateAutoGrab()
    autoArrest()
    autoEscape()
    autoEnterVehicle()
    autoInteract()
end

