local lastTime, lastUpdate, fpsAccumulator, frameCount = tick(), tick(), 0, 0

local function GetClosestTarget()
    local candidates, center = {}, Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if TeamCheck and player.Team == LocalPlayer.Team then continue end
        local char = player.Character
        if not char or not char:FindFirstChild("Head") or not char:FindFirstChild("HumanoidRootPart") then continue end
        local head, headPos3d = char.Head, char.Head.Position
        local pos, onScreen = Camera:WorldToViewportPoint(headPos3d)
        if not onScreen then continue end
        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if dist <= FOVRadius then table.insert(candidates, {player = player, dist = dist, headPos = headPos3d}) end
    end
    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    if SelectedPlayer then
        for i, cand in ipairs(candidates) do
            if cand.player == SelectedPlayer then table.remove(candidates, i) table.insert(candidates, 1, cand) break end
        end
    end
    for _, cand in ipairs(candidates) do
        local origin = Camera.CFrame.Position
        local direction = (cand.headPos - origin).Unit * (cand.headPos - origin).Magnitude
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LocalPlayer.Character or {}}
        params.IgnoreWater = true
        local result = workspace:Raycast(origin, direction, params)
        if not WallCheck or not result or result.Instance:IsDescendantOf(cand.player.Character) then return cand.player end
    end
    return nil
end

RunService.RenderStepped:Connect(function()
    local now = tick()
    local delta = now - lastTime
    lastTime = now
    fpsAccumulator += 1 / delta
    frameCount += 1
    targetUpdateSkip += 1
    if AimbotEnabled and targetUpdateSkip % 3 == 0 then RegCurrentTarget = GetClosestTarget() end
    if RegCurrentTarget and RegCurrentTarget.Character and RegCurrentTarget.Character:FindFirstChild("Head") then
        local head = RegCurrentTarget.Character.Head
        local root = RegCurrentTarget.Character.HumanoidRootPart
        local predictedPos = head.Position + (root.Velocity * 0.11)
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, predictedPos), Hardness)
    end
    if now - lastUpdate >= 0.3 then
        StatsLabel.Text = string.format("FPS: %d | Ping: %dms", math.floor(fpsAccumulator / frameCount + 0.5), math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5))
        lastUpdate, fpsAccumulator, frameCount = now, 0, 0
    end
end)

