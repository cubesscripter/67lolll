-- Auto Respawn
LocalPlayer.CharacterAdded:Connect(function(char)
    if PlayerConfig.autorespawn then
        task.wait(0.1)
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.HealthChanged:Connect(function(health)
                if health <= 0 then
                    task.wait(0.1)
                    LocalPlayer:LoadCharacter()
                end
            end)
        end
    end
    if PlayerConfig.walkspeed ~= 16 then
        task.wait(0.1)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = PlayerConfig.walkspeed end
    end
    if PlayerConfig.jumppower ~= 50 then
        task.wait(0.1)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.JumpPower = PlayerConfig.jumppower end
    end
end)

