-- Silent Aim Hook
local function noUpvals(fn) return function(...) return fn(...) end end
local origCastRay, hooked = nil, false

local function setupHook()
    local castRayFunc = filtergc("function", {Name = "castRay"}, true)
    if not castRayFunc then return false end
    origCastRay = hookfunction(castRayFunc, noUpvals(function(startPos, targetPos, ...)
        if not SAConfig.enabled then return origCastRay(startPos, targetPos, ...) end
        local closest = getClosest(SAConfig.fov)
        if closest and closest.Character then
            local gun = currentGun
            if not gun then return origCastRay(startPos, targetPos, ...) end
            local isTaser, shotgun, sniperStable = isTaserGun(gun), isShotgun(gun), isSniperStable(gun)
            local targetPart = getTargetPart(closest.Character)
            if not targetPart then return origCastRay(startPos, targetPos, ...) end
            if not isInCurrentGunRange(targetPart.Position, startPos) then return origCastRay(startPos, targetPos, ...) end
            if SAConfig.shotgungamehandled and shotgun then return origCastRay(startPos, targetPart.Position, ...) end
            local shouldHit = false
            if SAConfig.taseralwayshit and isTaser then shouldHit = true
            elseif SAConfig.ifplayerstill and isStanding(closest) then shouldHit = true
            elseif shouldBypassHitchance(gun) then shouldHit = true
            else shouldHit = rollHit(getDistanceBasedHitChance(targetPart, startPos)) end
            if shouldHit then
                if isSniper(gun) and not sniperStable then return origCastRay(startPos, targetPart.Position, ...) end
                if isTaser then return origCastRay(startPos, targetPart.Position, ...) end
                if SAConfig.shotgunnaturalspread and shotgun then return origCastRay(startPos, targetPart.Position, ...) end
                return targetPart, targetPart.Position
            else
                if SAConfig.missspread > 0 then
                    local missPos = getMissPos(startPos, targetPart)
                    return origCastRay(startPos, missPos, ...)
                end
                return origCastRay(startPos, targetPos, ...)
            end
        end
        return origCastRay(startPos, targetPos, ...)
    end))
    return true
end

if not setupHook() then
    task.spawn(function()
        while not hooked do
            task.wait(0.5)
            if setupHook() then hooked = true end
        end
    end)
else hooked = true end

